<%- include('partials/header') %>

<section class="hero rounded-4 p-4 p-md-5 mb-5 text-white">
  <div class="row align-items-center">
    <div class="col-lg-8">
      <span class="badge rounded-pill text-bg-light text-primary mb-3">Cadastros em um só lugar</span>
      <h1 class="display-5 fw-bold">Sistema de Gerenciamento</h1>
      <p class="lead mb-0">
        Uma aplicação simples e organizada para cadastrar, consultar, editar e excluir
        clientes, fornecedores e produtos, com acesso rápido pelos módulos abaixo.
      </p>
    </div>
    <div class="col-lg-4 d-none d-lg-block text-center">
      <i class="bi bi-diagram-3 hero-icon"></i>
    </div>
  </div>
</section>

<section class="mb-5">
  <h2 class="h4 fw-bold mb-3">Módulos</h2>
  <div class="row g-4">
    <% Object.values(modulos).forEach(function (m) { %>
      <div class="col-12 col-md-6 col-lg-4">
        <div class="card module-card h-100 shadow-sm border-0">
          <div class="card-body p-4 d-flex flex-column">
            <div class="module-icon mb-3"><i class="bi <%= m.icone %>"></i></div>
            <h3 class="h5 fw-bold"><%= m.plural %></h3>
            <p class="text-secondary flex-grow-1"><%= m.descricao %></p>
            <div class="d-flex justify-content-between align-items-center">
              <span class="badge text-bg-primary-subtle text-primary-emphasis">
                <%= totais[m.chave] %> <%= totais[m.chave] === 1 ? 'registro' : 'registros' %>
              </span>
              <div class="d-flex gap-2">
                <a href="/<%= m.chave %>/novo" class="btn btn-sm btn-outline-primary"><i class="bi bi-plus-lg"></i> Novo</a>
                <a href="/<%= m.chave %>" class="btn btn-sm btn-primary">Acessar <i class="bi bi-arrow-right"></i></a>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</section>

<section class="card border-0 shadow-sm">
  <div class="card-body p-4">
    <div class="row g-4 align-items-center">
      <div class="col-md-6">
        <h2 class="h5 fw-bold"><i class="bi bi-people-fill text-primary me-2"></i>Desenvolvedores</h2>
        <p class="mb-0 text-secondary">Projeto desenvolvido por <strong class="text-body"><%= desenvolvedores %></strong>.</p>
      </div>
      <div class="col-md-6">
        <h2 class="h5 fw-bold"><i class="bi bi-code-slash text-primary me-2"></i>Tecnologias</h2>
        <p class="mb-0 text-secondary">Node.js, Express, EJS, Bootstrap 5, HTML, CSS e JavaScript.</p>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
